# ---- Data & models (never commit; they are GBs and often licence-restricted) ----
# Ignore contents but let git descend into the dirs so .gitkeep survives --
# otherwise a fresh clone is missing the directory tree the scripts expect.
data/**
!data/**/
!data/**/.gitkeep
!data/**/README.md
!data/manifests/*.csv
models/**
!models/**/
!models/**/.gitkeep
*.pt
*.pth
*.onnx
*.mlpackage
*.tflite
*.h5
*.ckpt

# ---- Experiment tracking / outputs ----
runs/
outputs/
lightning_logs/
wandb/
mlruns/
docs/reports/*.pdf
!docs/reports/.gitkeep

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ---- Secrets & local config ----
.env
.env.*
!.env.example
kaggle.json
*.pem

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- MATLAB / Simulink autogenerated ----
slprj/
*.slxc
*.asv
*.autosave
